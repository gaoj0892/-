# 默认：文本文件统一 LF 行尾（Windows 下避免 CRLF 噪音）
* text=auto eol=lf

# git hooks 必须 LF：CRLF 会让 Git Bash 报 `bad interpreter: /bin/sh^M`
.husky/** text eol=lf
*.sh text eol=lf

# 种子数据是脚本生成的逐期一行格式，GitHub 上默认折叠 diff
src/data/dlt_history.json linguist-generated=true

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.zip binary
