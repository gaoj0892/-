{
  "name": "dlt-predictor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "超级大乐透开奖数据分析与选号辅助（本地单页应用）",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
